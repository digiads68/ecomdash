# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to run without real TikTok credentials.
# All OAuth connections will be simulated using seed data.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ecomdash:ecomdash@localhost:5432/ecomdash

# ── ClickHouse ─────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DB=ecomdash
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Clerk Auth ─────────────────────────────────────────────────────────────────
# Get from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# ── TikTok Shop API ────────────────────────────────────────────────────────────
# Register at https://partner.tiktokshop.com → Developer → Create App
# Required scopes: product.list, order.list, finance.data, shop.info
# Leave as "xxx" when DEMO_MODE=true
TIKTOK_APP_KEY=xxx
TIKTOK_APP_SECRET=xxx

# ── TikTok Ads API ─────────────────────────────────────────────────────────────
# Register at https://ads.tiktok.com/marketing_api/apps → Create App
# Required scopes: ad_account.list, campaign.read, report.read
# Leave as "xxx" when DEMO_MODE=true
TIKTOK_ADS_APP_ID=xxx
TIKTOK_ADS_APP_SECRET=xxx

# Callback URLs — must match exactly what's registered in TikTok developer portal
# In production: https://yourdomain.com/api/tiktok/shop/callback
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/shop/callback

# ── Token Encryption ───────────────────────────────────────────────────────────
# 32-byte key encoded as base64 (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The demo key below is safe for local development only — change in production!
ENCRYPTION_KEY=bXlzdXBlcnNlY3JldGtleWZvcmRldmVsb3BtZW50MTI=

# ── Invite JWT ─────────────────────────────────────────────────────────────────
INVITE_JWT_SECRET=change-this-in-production

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_STARTER_PRICE_ID=price_xxx
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxx

# ── SendGrid ───────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@ecomdash.vn

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=xxx

# ── App URLs ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
API_URL=http://localhost:4000/api
