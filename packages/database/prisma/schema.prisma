// Source of truth: docs/architecture/03-data-model.md and 11-profit-and-loss.md
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Organisation & users ─────────────

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  plan        Plan      @default(STARTER)
  status      OrgStatus @default(ACTIVE)
  adsMode     AdsMode   @default(TIKTOK)
  onboardedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members              OrganizationMember[]
  sellerAuthorizations SellerAuthorization[]
  shops                Shop[]
  adsAuthorizations    AdsAuthorization[]
  advertisers          Advertiser[]
  alertRules           AlertRule[]
  alertInstances       AlertInstance[]
  reportConfigs        ReportConfig[]
  syncStates           SyncState[]
  syncRounds           SyncRound[]
  invitations          Invitation[]
  auditLogs            AuditLog[]
  subscription         Subscription?
}

model User {
  id           String        @id @default(cuid())
  email        String?       @unique
  name         String?
  avatarUrl    String?
  passwordHash String?
  platformRole PlatformRole?
  tiktokOpenId String?       @unique
  status       UserStatus    @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())

  memberships OrganizationMember[]
  shopAccess  ShopAccess[]         @relation("ShopAccessUser")
  sessions    Session[]
}

/// Per-shop view grant for platform MODs and organisation MEMBERs (docs/architecture/12).
model ShopAccess {
  id          String   @id @default(cuid())
  userId      String
  shopId      String
  grantedById String?
  createdAt   DateTime @default(now())

  user User @relation("ShopAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([shopId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id             String        @id @default(cuid())
  email          String
  organizationId String?
  platformRole   PlatformRole?
  orgRole        MemberRole?
  shopIds        String[]
  tokenHash      String        @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime      @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  action         String
  organizationId String?
  targetType     String
  targetId       String
  meta           Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  inviteEmail    String?
  role           MemberRole
  status         MemberStatus @default(ACTIVE)
  permissions    Json         @default("{}")
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
}

// ───────────── TikTok Shop connection ─────────────

model SellerAuthorization {
  id                    String     @id @default(cuid())
  organizationId        String?
  openId                String     @unique
  source                AuthSource @default(SELF_SIGNUP)
  sellerName            String
  sellerBaseRegion      String
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  accessExpiresAt       DateTime
  refreshExpiresAt      DateTime
  grantedScopes         String[]
  status                AuthStatus @default(ACTIVE)
  lastRefreshedAt       DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  shops        Shop[]
}

model Shop {
  id                    String   @id @default(cuid())
  organizationId        String?
  sellerAuthorizationId String
  tiktokShopId          String   @unique
  cipher                String
  code                  String?
  name                  String
  region                String   @default("VN")
  sellerType            String   @default("LOCAL")
  currency              String   @default("VND")
  timezone              String   @default("Asia/Ho_Chi_Minh")
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization        Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sellerAuthorization SellerAuthorization   @relation(fields: [sellerAuthorizationId], references: [id], onDelete: Cascade)
  access              ShopAccess[]
  config              ShopConfig?
  products            Product[]
  orders              Order[]
  statements          Statement[]
  returns             ReturnRequest[]
  dailyStats          ShopDailyStat[]
  dailyPnl            ShopDailyPnl[]
  productDailyStats   ProductDailyStat[]
  storeLinks          AdvertiserStoreLink[]
  alertRules          AlertRule[]
  reportConfigs       ReportConfig[]
  skuCosts            SkuCost[]
  costItems           CostItem[]

  @@index([organizationId])
}

model ShopConfig {
  id                 String  @id @default(cuid())
  shopId             String  @unique
  defaultCogsPercent Decimal @default(40) @db.Decimal(5, 2)
  restockReturns     Boolean @default(true)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

// ───────────── Commerce ─────────────

model Product {
  id              String   @id @default(cuid())
  shopId          String
  tiktokProductId String
  title           String
  status          String
  thumbnailUrl    String?
  categoryName    String?
  tiktokCreatedAt DateTime
  tiktokUpdatedAt DateTime
  syncedAt        DateTime @default(now())

  shop       Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  skus       Sku[]
  dailyStats ProductDailyStat[]

  @@unique([shopId, tiktokProductId])
}

model Sku {
  id          String   @id @default(cuid())
  productId   String
  tiktokSkuId String
  sellerSku   String?
  name        String?
  salePrice   Decimal  @db.Decimal(18, 2)
  listPrice   Decimal? @db.Decimal(18, 2)
  inventory   Int      @default(0)

  product Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  costs   SkuCost[]

  @@unique([productId, tiktokSkuId])
  @@index([tiktokSkuId])
}

model Order {
  id                    String      @id @default(cuid())
  shopId                String
  tiktokOrderId         String
  status                OrderStatus
  buyerHash             String
  province              String?
  currency              String      @default("VND")
  subTotal              Decimal     @db.Decimal(18, 2)
  shippingFee           Decimal     @db.Decimal(18, 2)
  sellerDiscount        Decimal     @db.Decimal(18, 2)
  platformDiscount      Decimal     @db.Decimal(18, 2)
  totalAmount           Decimal     @db.Decimal(18, 2)
  originalProductPrice  Decimal     @db.Decimal(18, 2)
  isCod                 Boolean     @default(false)
  isSampleOrder         Boolean     @default(false)
  paymentMethod         String?
  shippingProvider      String?
  shippingType          String?
  trackingNumber        String?
  cancelReason          String?
  cancellationInitiator String?
  createTime            DateTime
  updateTime            DateTime
  paidTime              DateTime?
  rtsTime               DateTime?
  deliveryTime          DateTime?
  cancelTime            DateTime?
  businessDate          DateTime    @db.Date
  syncedAt              DateTime    @default(now())

  shop       Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lineItems  OrderLineItem[]
  settlement OrderSettlement?
  returns    ReturnRequest[]
  economics  OrderEconomics?

  @@unique([shopId, tiktokOrderId])
  @@index([shopId, businessDate])
  @@index([shopId, status])
  @@index([shopId, buyerHash])
}

model OrderLineItem {
  id               String  @id @default(cuid())
  orderId          String
  tiktokLineItemId String
  tiktokProductId  String
  tiktokSkuId      String
  productName      String
  skuName          String?
  sellerSku        String?
  skuImage         String?
  originalPrice    Decimal @db.Decimal(18, 2)
  salePrice        Decimal @db.Decimal(18, 2)
  sellerDiscount   Decimal @db.Decimal(18, 2)
  platformDiscount Decimal @db.Decimal(18, 2)
  displayStatus    String?
  isGift           Boolean @default(false)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, tiktokLineItemId])
  @@index([tiktokProductId])
  @@index([tiktokSkuId])
}

// ───────────── Finance ─────────────

model Statement {
  id                 String   @id @default(cuid())
  shopId             String
  tiktokStatementId  String
  statementTime      DateTime
  currency           String
  revenueAmount      Decimal  @db.Decimal(18, 2)
  feeAmount          Decimal  @db.Decimal(18, 2)
  adjustmentAmount   Decimal  @db.Decimal(18, 2)
  shippingCostAmount Decimal  @db.Decimal(18, 2)
  settlementAmount   Decimal  @db.Decimal(18, 2)
  paymentStatus      String
  paymentId          String?

  shop        Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  adjustments StatementAdjustment[]

  @@unique([shopId, tiktokStatementId])
  @@index([shopId, statementTime])
}

/// Statement-level adjustments, e.g. GMV_PAYMENT_FOR_ADS (ads paid from the shop balance) — reconciliation only.
model StatementAdjustment {
  id          String  @id @default(cuid())
  statementId String
  type        String
  amount      Decimal @db.Decimal(18, 2)
  reference   String?

  statement Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([statementId, type, reference])
}

model OrderSettlement {
  id                     String    @id @default(cuid())
  orderId                String    @unique
  tiktokStatementId      String?
  currency               String
  revenueAmount          Decimal   @db.Decimal(18, 2)
  shippingCostAmount     Decimal   @db.Decimal(18, 2)
  feeTaxAmount           Decimal   @db.Decimal(18, 2)
  platformCommission     Decimal   @default(0) @db.Decimal(18, 2)
  transactionFee         Decimal   @default(0) @db.Decimal(18, 2)
  affiliateCommission    Decimal   @default(0) @db.Decimal(18, 2)
  infrastructureFee      Decimal   @default(0) @db.Decimal(18, 2)
  otherFees              Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount              Decimal   @default(0) @db.Decimal(18, 2)
  gmvMaxAdFee            Decimal   @default(0) @db.Decimal(18, 2)
  affiliateAdsCommission Decimal   @default(0) @db.Decimal(18, 2)
  settlementAmount       Decimal   @db.Decimal(18, 2)
  raw                    Json
  settledAt              DateTime?
  syncedAt               DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ───────────── Returns / cancellations ─────────────

model ReturnRequest {
  id             String     @id @default(cuid())
  shopId         String
  orderId        String?
  tiktokReturnId String
  tiktokOrderId  String
  kind           ReturnKind
  status         String
  reason         String?
  refundTotal    Decimal    @default(0) @db.Decimal(18, 2)
  returnedUnits  Int        @default(0)
  createTime     DateTime
  updateTime     DateTime
  businessDate   DateTime   @db.Date

  shop  Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id])

  @@unique([shopId, tiktokReturnId])
  @@index([shopId, businessDate])
  @@index([shopId, tiktokOrderId])
}

// ───────────── Ads ─────────────

model AdsAuthorization {
  id                   String      @id @default(cuid())
  organizationId       String?
  kind                 AdsAuthKind @default(CLIENT)
  bcId                 String?
  label                String?
  accessTokenEncrypted String
  scopes               String[]
  status               AuthStatus  @default(ACTIVE)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  organization Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  advertisers  AdvertiserAuthorization[]
}

/// One advertiser can be reachable through several tokens (the client's own OAuth and DigiAds' Business Center).
model AdvertiserAuthorization {
  advertiserId       String
  adsAuthorizationId String
  createdAt          DateTime @default(now())

  advertiser       Advertiser       @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  adsAuthorization AdsAuthorization @relation(fields: [adsAuthorizationId], references: [id], onDelete: Cascade)

  @@id([advertiserId, adsAuthorizationId])
}

model Advertiser {
  id                 String   @id @default(cuid())
  organizationId     String?
  tiktokAdvertiserId String   @unique
  name               String
  currency           String   @default("VND")
  timezone           String   @default("Asia/Ho_Chi_Minh")
  ownerBcId          String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization   Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  authorizations AdvertiserAuthorization[]
  campaigns      Campaign[]
  storeLinks     AdvertiserStoreLink[]
  dailyStats     AdDailyStat[]

  @@index([organizationId])
}

model AdvertiserStoreLink {
  id                  String  @id @default(cuid())
  advertiserId        String
  storeId             String
  storeCode           String?
  storeName           String
  storeAuthorizedBcId String?
  shopId              String?
  matchedBy           String?
  isGmvMaxAvailable   Boolean @default(false)

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  shop       Shop?      @relation(fields: [shopId], references: [id])

  @@unique([advertiserId, storeId])
}

model Campaign {
  id               String       @id @default(cuid())
  advertiserId     String
  tiktokCampaignId String
  name             String
  kind             CampaignKind
  objectiveType    String?
  operationStatus  String
  budgetMode       String?
  budget           Decimal?     @db.Decimal(18, 2)
  roasBid          Decimal?     @db.Decimal(10, 2)
  storeId          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  advertiser Advertiser    @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  dailyStats AdDailyStat[]

  @@unique([advertiserId, tiktokCampaignId])
}

model AdDailyStat {
  id           String       @id @default(cuid())
  advertiserId String
  campaignId   String
  date         DateTime     @db.Date
  source       AdStatSource
  storeId      String?
  spend        Decimal      @db.Decimal(18, 2)
  impressions  Int          @default(0)
  clicks       Int          @default(0)
  conversions  Int          @default(0)
  orders       Int          @default(0)
  grossRevenue Decimal      @default(0) @db.Decimal(18, 2)
  syncedAt     DateTime     @default(now())

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date, source])
  @@index([advertiserId, date])
}

// ───────────── Daily rollups ─────────────

model ShopDailyStat {
  id                 String   @id @default(cuid())
  shopId             String
  date               DateTime @db.Date
  gmv                Decimal  @db.Decimal(18, 2)
  orders             Int
  unitsSold          Int
  buyers             Int
  newBuyers          Int
  cancelledOrders    Int
  cancelledAmount    Decimal  @db.Decimal(18, 2)
  returnRequests     Int
  refundAmount       Decimal  @db.Decimal(18, 2)
  codOrders          Int
  sellerDiscount     Decimal  @db.Decimal(18, 2)
  pageViews          Int?
  visitors           Int?
  analyticsGmv       Decimal? @db.Decimal(18, 2)
  gmvMaxRevenueShare Decimal? @db.Decimal(5, 4)
  computedAt         DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, date])
}

model ProductDailyStat {
  id                String   @id @default(cuid())
  shopId            String
  productId         String
  date              DateTime @db.Date
  gmv               Decimal  @db.Decimal(18, 2)
  orders            Int
  unitsSold         Int
  pageViews         Int?
  impressions       Int?
  grossItemValue    Decimal  @default(0) @db.Decimal(18, 2)
  cancelledAmount   Decimal  @default(0) @db.Decimal(18, 2)
  refundAmount      Decimal  @default(0) @db.Decimal(18, 2)
  realizedRevenue   Decimal  @default(0) @db.Decimal(18, 2)
  platformFees      Decimal  @default(0) @db.Decimal(18, 2)
  otherPlatformFees Decimal  @default(0) @db.Decimal(18, 2)
  cogs              Decimal  @default(0) @db.Decimal(18, 2)
  cogsEstimated     Boolean  @default(false)
  customCosts       Decimal  @default(0) @db.Decimal(18, 2)
  adSpendAllocated  Decimal  @default(0) @db.Decimal(18, 2)
  contribution      Decimal  @default(0) @db.Decimal(18, 2)
  netProfit         Decimal  @default(0) @db.Decimal(18, 2)
  returnedUnits     Int      @default(0)

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([shopId, date])
}

// ───────────── Profit & loss ─────────────

model SkuCost {
  id            String   @id @default(cuid())
  shopId        String
  skuId         String
  unitCost      Decimal  @db.Decimal(18, 2)
  effectiveFrom DateTime @db.Date
  note          String?
  createdAt     DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sku  Sku  @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([skuId, effectiveFrom])
  @@index([shopId])
}

model CostItem {
  id            String        @id @default(cuid())
  shopId        String
  name          String
  method        CostMethod
  amount        Decimal       @db.Decimal(18, 2)
  appliesTo     CostAppliesTo @default(SHIPPED)
  effectiveFrom DateTime      @db.Date
  effectiveTo   DateTime?     @db.Date
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model OrderEconomics {
  orderId           String       @id
  shopId            String
  businessDate      DateTime     @db.Date
  outcome           OrderOutcome
  itemNet           Decimal      @db.Decimal(18, 2)
  buyerPaid         Decimal      @db.Decimal(18, 2)
  cancelledAmount   Decimal      @db.Decimal(18, 2)
  refundAmount      Decimal      @db.Decimal(18, 2)
  pendingAmount     Decimal      @db.Decimal(18, 2)
  realizedRevenue   Decimal      @db.Decimal(18, 2)
  platformFees      Decimal      @db.Decimal(18, 2)
  otherPlatformFees Decimal      @db.Decimal(18, 2)
  settlementAmount  Decimal      @db.Decimal(18, 2)
  feesEstimated     Boolean
  units             Int
  costedUnits       Int
  cogs              Decimal      @db.Decimal(18, 2)
  cogsEstimated     Boolean
  customCosts       Decimal      @db.Decimal(18, 2)
  contribution      Decimal      @db.Decimal(18, 2)
  computedAt        DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([shopId, businessDate])
  @@index([shopId, outcome])
}

model ShopDailyPnl {
  id                String   @id @default(cuid())
  shopId            String
  date              DateTime @db.Date
  ordersPaid        Int
  ordersSuccess     Int
  ordersPartial     Int
  ordersReturned    Int
  ordersCancelled   Int
  ordersPending     Int
  grossItemValue    Decimal  @db.Decimal(18, 2)
  buyerPaid         Decimal  @db.Decimal(18, 2)
  cancelledAmount   Decimal  @db.Decimal(18, 2)
  refundAmount      Decimal  @db.Decimal(18, 2)
  pendingAmount     Decimal  @db.Decimal(18, 2)
  pendingExpected   Decimal  @db.Decimal(18, 2)
  realizedRevenue   Decimal  @db.Decimal(18, 2)
  platformFees      Decimal  @db.Decimal(18, 2)
  otherPlatformFees Decimal  @db.Decimal(18, 2)
  settlementAmount  Decimal  @db.Decimal(18, 2)
  feesEstimated     Decimal  @db.Decimal(18, 2)
  cogs              Decimal  @db.Decimal(18, 2)
  cogsEstimated     Decimal  @db.Decimal(18, 2)
  customCostsOrder  Decimal  @db.Decimal(18, 2)
  customCostsFixed  Decimal  @db.Decimal(18, 2)
  customBreakdown   Json     @default("{}")
  contribution      Decimal  @db.Decimal(18, 2)
  adSpend           Decimal  @db.Decimal(18, 2)
  adSpendManual     Decimal  @db.Decimal(18, 2)
  adSpendGmvMax     Decimal  @db.Decimal(18, 2)
  tiktokAdRevenue   Decimal  @db.Decimal(18, 2)
  tiktokAdOrders    Int
  netProfit         Decimal  @db.Decimal(18, 2)
  estimatedShare    Decimal  @db.Decimal(5, 4)
  feeBreakdown      Json     @default("{}")
  computedAt        DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, date])
}

// ───────────── Operations ─────────────

model SyncState {
  id             String        @id @default(cuid())
  organizationId String?
  scopeType      String
  scopeId        String
  resource       String
  cursor         DateTime?
  status         SyncRunStatus @default(IDLE)
  lastStartedAt  DateTime?
  lastSuccessAt  DateTime?
  lastError      String?
  lastWarning    String?
  itemsLastRun   Int           @default(0)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([scopeType, scopeId, resource])
}

/// One synchronisation round of an organisation: orders + returns + ad reports pulled together (12 §4).
model SyncRound {
  id             String    @id @default(cuid())
  organizationId String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  shopOk         Boolean   @default(false)
  adsOk          Boolean   @default(false)
  shopSyncedTo   DateTime?
  adsSyncedTo    DateTime?
  error          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
}

model WebhookEvent {
  id                String    @id @default(cuid())
  ttsNotificationId String    @unique
  type              Int
  tiktokShopId      String?
  payload           Json
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?
}

// ───────────── Alerts, reports, billing ─────────────

model AlertRule {
  id             String   @id @default(cuid())
  organizationId String
  shopId         String?
  name           String
  conditions     Json
  actions        Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shop         Shop?           @relation(fields: [shopId], references: [id])
  instances    AlertInstance[]
}

model AlertInstance {
  id             String     @id @default(cuid())
  ruleId         String?
  organizationId String
  shopId         String?
  kind           String     @default("RULE")
  title          String
  state          AlertState
  metadata       Json       @default("{}")
  firedAt        DateTime   @default(now())
  resolvedAt     DateTime?
  acknowledgedAt DateTime?

  rule         AlertRule?   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, state])
}

model ReportConfig {
  id             String    @id @default(cuid())
  organizationId String
  shopId         String
  frequency      String
  dayOfWeek      Int?
  dayOfMonth     Int?
  recipientEmail String
  isActive       Boolean   @default(true)
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  plan                 Plan
  status               SubscriptionStatus
  stripeSubscriptionId String?
  stripeCustomerId     String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ───────────── Enums ─────────────

enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum MemberRole {
