{
  "name": "ecomdash",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build:packages": "pnpm --filter @ecomdash/shared --filter @ecomdash/tiktok-client --filter @ecomdash/database build",
    "dev": "turbo run dev --filter=@ecomdash/mock-tiktok --filter=@ecomdash/api --filter=@ecomdash/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @ecomdash/database db:generate",
    "db:migrate": "pnpm --filter @ecomdash/database db:migrate",
    "db:seed": "pnpm --filter @ecomdash/database db:seed",
    "demo": "bash scripts/demo.sh",
    "demo:connect": "pnpm --filter @ecomdash/api exec tsx ../../scripts/demo-connect.ts",
    "demo:reset": "bash scripts/demo-reset.sh",
    "check:access": "pnpm --filter @ecomdash/api exec tsx ../../scripts/check-access.ts",
    "doctor": "bash scripts/doctor.sh"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "prettier": "^3.3.0",
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.4.0"
}
